# 图片缓存30天
/photos/*.webp
  Cache-Control: public, max-age=2592000, immutable

/photos/**/*.webp
  Cache-Control: public, max-age=2592000, immutable

# 视频缓存30天
/*.mp4
  Cache-Control: public, max-age=2592000, immutable

# 音频缓存30天
/*.m4a
  Cache-Control: public, max-age=2592000, immutable

# JS/CSS资源缓存1年（文件名含hash）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML不缓存（确保更新及时）
/*
  Cache-Control: public, max-age=0, must-revalidate
